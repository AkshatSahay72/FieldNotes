# ==============================================================================
# Fieldnote — Environment Configuration Template
# Copy this file to .env and provide your specific environment details.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# MongoDB Atlas Configuration
# Example format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=fieldnote_db

# File Storage Configuration (for evidence attachments)
UPLOAD_DIR=uploads

# Vector Search & Embeddings Configuration (Milestone 6)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
