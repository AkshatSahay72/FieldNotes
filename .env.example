# ==============================================================================
# Fieldnote — Environment Configuration Template
# Copy this file to .env and provide your specific environment details.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Operational Mode ('demo' for public read-only, 'authenticated' for single-owner private)
# - When set to 'demo' (or DEMO_MODE=true), all write mutations are rejected with HTTP 403.
#   A dedicated demo database must be specified via DATABASE_NAME (e.g. fieldnote_demo).
# - When set to 'authenticated', full single-owner auth is active, targeting fieldnote_private.
APP_MODE=demo
DEMO_MODE=true

# MongoDB Atlas Configuration
# Example format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
# Target Database: 'fieldnote_demo' (public demo) or 'fieldnote_private' (single-owner)
DATABASE_NAME=fieldnote_demo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# File Storage Configuration (temporary local upload buffer if needed)
UPLOAD_DIR=uploads

# Vector Search & Embeddings Configuration (Milestone 6)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Single-Owner Authentication, Sessions & Security
SESSION_COOKIE_NAME=fieldnote_session
CSRF_COOKIE_NAME=fieldnote_csrf
SESSION_LIFETIME_SECONDS=604800
# Set to true for HTTPS deployments (Render defaults to true in production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
